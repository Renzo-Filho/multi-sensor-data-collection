<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/s3_category_connection">

        <EditTextPreference
            app:key="name"
            app:title="@string/s3_name_title"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:key="endpoint"
            app:title="@string/s3_endpoint_title"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:key="region"
            app:title="@string/s3_region_title"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:key="bucket"
            app:title="@string/s3_bucket_title"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:key="path_style"
            app:title="@string/s3_path_style_title"
            app:singleLineTitle="false"
            app:summaryOn="@string/s3_path_style_on"
            app:summaryOff="@string/s3_path_style_off" />

        <EditTextPreference
            app:key="access_key"
            app:title="@string/s3_access_key_title" />

        <EditTextPreference
            app:key="secret_key"
            app:title="@string/s3_secret_key_title" />

        <Preference
            app:key="trust_certificate"
            app:title="@string/s3_trust_certificate_title" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/s3_category_upload">

        <EditTextPreference
            app:key="key_template"
            app:title="@string/s3_key_template_title"
            app:dialogMessage="@string/s3_key_template_help"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:key="zip_mode"
            app:title="@string/s3_zip_mode_title"
            app:singleLineTitle="false"
            app:summaryOn="@string/s3_zip_mode_on"
            app:summaryOff="@string/s3_zip_mode_off" />

        <EditTextPreference
            app:key="part_size_mib"
            app:title="@string/s3_part_size_title" />

        <SwitchPreferenceCompat
            app:key="overwrite"
            app:title="@string/s3_overwrite_title"
            app:singleLineTitle="false"
            app:summaryOn="@string/s3_overwrite_on"
            app:summaryOff="@string/s3_overwrite_off" />
    </PreferenceCategory>

    <Preference
        app:key="test_connection"
        app:title="@string/s3_test_connection_title"
        app:summary="@string/s3_test_connection_summary" />

    <Preference
        app:key="delete_destination"
        app:title="@string/s3_delete_destination_title" />

</PreferenceScreen>
